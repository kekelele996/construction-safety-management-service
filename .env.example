# SafetyPlatform 本地 Compose 启动配置（仅用于开发/评测）
COMPOSE_PROJECT_NAME=safety-platform
DB_NAME=safety_db
DB_USER=safety_user
DB_PASSWORD=safety_pwd
DB_ROOT_PASSWORD=safety_root
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_HOURS=72
APP_CORS_ORIGINS=http://localhost:18702
FRONTEND_PORT=18702
BACKEND_PORT=19202
DB_PORT=3306
